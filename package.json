{
  "name": "dsh-claude-layout",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: Claude-style Workspaces sidebar with folders that group workspaces, a Pinned section, and drag-and-drop",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/client.test.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "workspaces",
    "folders"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William20100221/dsh-claude-layout.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
