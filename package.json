{
  "name": "dsh-beta-layout-folder-file",
  "version": "0.3.1",
  "description": "DeepSeek Harness plugin: folders, a fork tree, Claude-style drag effects, ZIP export and AI titles for the Workspaces sidebar, keeping DSH's own UI",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/title.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/client.test.js test/title.test.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "workspaces",
    "folders",
    "export",
    "titles"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William20100221/dsh-beta-layout-folder-file.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-title-llm": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
